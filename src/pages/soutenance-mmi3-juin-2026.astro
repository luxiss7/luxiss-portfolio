---
import BaseLayout from "../layouts/BaseLayout.astro";
---

<BaseLayout
  title="Soutenance MMI 2026"
  currentPage="soutenance-mmi3-juin-2026"
  robots="noindex"
>
  <style is:global>
    body[data-page="soutenance-mmi3-juin-2026"] header {
      margin-top: 2rem;
    }

    body[data-page="soutenance-mmi3-juin-2026"] header .logo-container {
      display: none !important;
    }
  </style>
  <style>
    :root {
      --lx-accent-color: #ff6e30;
      --lx-accent-light-color: #e7c2ab;
      --lx-accent-dark-color: #a44400;
    }

    #previous-button,
    #next-button {
      background: var(--lx-pane);
      border: 2px solid var(--lx-accent-color);
      height: 25rem;
      padding: 10px 20px;
      color: var(--lx-accent-color);
      font-weight: bold;
      cursor: pointer;
      transition: all 0.3s ease;
    }

    #previous-button:hover,
    #next-button:hover {
      background: var(--lx-accent-color);
      color: var(--lx-pane);
    }

    #soutenance-interface {
      display: flex;
      flex-direction: row;
      justify-content: center;
      align-items: center;
      width: 100%;
      padding: 20px;
      min-height: 69vh;
      gap: 2rem;
    }

    .soutenance-details {
      font-size: x-large;
      width: 65rem;
      height: 35rem;
      box-sizing: border-box;
      background-color: var(--lx-pane);
      border: 2px solid var(--lx-accent-color);
      padding: 2rem;
      gap: 2rem;
      color: var(--lx-text-color);
      animation: fadeIn 1s ease;
    }

    .slide {
      display: none;
      animation: fadeIn 0.5s ease;
    }

    .slide h2,
    .slide .center-text,
    .center-content {
      text-align: center;
    }

    .slide.active {
      display: flex;
      flex-direction: column;
      justify-content: space-around;
      align-items: center;
      padding: 0 2rem;
      height: 100%;
    }

    .slide h2 {
      margin: 0;
      flex-shrink: 0;
    }

    .slide-content {
      flex: 1;
      display: flex;
      flex-direction: column;
      justify-content: center;
    }

    .title-slide.active {
      display: flex;
      flex-direction: column;
      justify-content: center;
      align-items: center;
      height: 100%;
      text-align: center;
    }

    .title-slide h1 {
      font-size: 3rem;
      margin-bottom: 1rem;
    }

    .title-slide p {
      font-size: 1.5rem;
      opacity: 0.8;
    }

    .soutenance-block {
      display: flex;
      flex-direction: row;
      justify-content: center;
      align-items: center;
      gap: 2rem;
      margin: 2rem 0;
    }

    .soutenance-block.reverse {
      flex-direction: row-reverse;
    }

    .soutenance-block.img-rows {
      max-height: 150px;
    }

    .center-text {
      margin-top: 2rem;
    }

    .tree {
      display: flex;
      flex-direction: row;
      justify-content: center;
      align-items: center;
      gap: 2rem;
    }

    .tree-box {
      display: flex;
      flex-direction: column;
      align-items: center;
      width: 15rem;
      height: 10rem;
    }

    .tree-box svg {
      margin: 1.5rem 0;
    }

    .org-chart {
      width: 100%;
      height: 60px;
      margin: 1.5rem 0;
    }

    .org-chart line {
      stroke: var(--lx-accent-color);
      stroke-width: 2;
    }

    b {
      color: var(--lx-accent-color);
    }

    li {
      list-style: "> ";
      margin: 1.5rem;
    }

    li::marker {
      color: var(--lx-accent-color);
    }

    img {
      height: 8rem;
      border: 2px solid var(--lx-accent-color);
    }

    .zoomed:hover {
      position: fixed;
      top: 50%;
      left: 50%;
      transform: translate(-50%, -50%);
      background: var(--lx-text-faint);
      backdrop-filter: blur(8px);
      width: auto;
      height: 34rem !important;
      z-index: 9999;
    }

    .transparent {
      opacity: 0 !important;
      pointer-events: none;
    }

    #slide-number {
      position: fixed;
      bottom: 2rem;
      right: 2rem;
      background: var(--lx-pane);
      border: 2px solid var(--lx-accent-color);
      padding: 10px 20px;
      color: var(--lx-accent-color);
      font-weight: bold;
    }
  </style>
  <div id="soutenance-interface">
    <button id="previous-button" class="transparent">&lt;</button>

    <div class="soutenance-details">
      <div class="slide title-slide active">
        <h1>Soutenance finale MMI</h1>
        <p>Lucas MUSY</p>
      </div>

      <div class="slide">
        <h2>Sommaire</h2>
        <div class="soutenance-block slide-content">
          <ul>
            <li>Présentation de l’entreprise</li>
            <li>Présentation de ma mission principale</li>
            <li>Sélection de réalisations</li>
            <li>Bilan de la formation BUT MMI</li>
            <li>Avenir professionnel</li>
          </ul>
          <img
            src="/images/soutenance-mmi3-juin-2026/enalean_logo.svg"
            alt="Sommaire"
            style="border: none;"
          />
        </div>
      </div>

      <div class="slide title-slide">
        <h1>1. Présentation de l’entreprise</h1>
        <p>Enalean et Tuleap</p>
      </div>

      <div class="slide">
        <h2>L'entreprise Enalean</h2>
        <div class="slide-content">
          <div class="soutenance-block img-rows">
            <p>
              Spécialisé depuis + de 15 ans dans la création d’un outil capable
              d’accompagner les projets logiciels, nommé <b>Tuleap</b>.
            </p>
            <img
              src="/images/soutenance-mmi3-juin-2026/tuleap_logo.svg"
              alt="Tuleap logo"
              style="border: none;"
            />
          </div>
          <div class="soutenance-block reverse img-rows">
            <p>
              <b>Enalean</b> est une PME d’une vingtaine de salariés, repartis en
              différent pôles.
            </p>
            <img
              src="/images/soutenance-mmi3-juin-2026/enalean_logo.svg"
              alt="Enalean logo"
              style="border: none;"
            />
          </div>
        </div>
      </div>

      <div class="slide">
        <h2>Pôle R&D</h2>
        <div class="slide-content">
          <p class="center-text">Manager : Manuel VACELET</p>
          <div class="tree-chart">
            <svg class="org-chart" viewBox="0 0 100 40">
              <line x1="50" y1="0" x2="50" y2="15"></line>
              <line x1="-40" y1="15" x2="140" y2="15"></line>
              <line x1="-40" y1="15" x2="-40" y2="35"></line>
              <line x1="140" y1="15" x2="140" y2="35"></line>
            </svg>
            <div class="tree">
              <div class="tree-box">
                <h3>IT</h3>
                <svg width="10" height="40">
                  <line
                    x1="5"
                    y1="0"
                    x2="5"
                    y2="40"
                    stroke="var(--lx-accent-color)"
                    stroke-width="3"></line>
                </svg>
                <p>Kevin et Nicolas</p>
              </div>
              <div class="tree-box">
                <h3>Design</h3>
                <svg width="10" height="40">
                  <line
                    x1="5"
                    y1="0"
                    x2="5"
                    y2="40"
                    stroke="var(--lx-accent-color)"
                    stroke-width="3"></line>
                </svg>
                <p>Quentin</p>
              </div>
            </div>
          </div>
        </div>
      </div>

      <div class="slide">
        <h2>Travailler chez Enalean</h2>
        <div class="soutenance-block slide-content">
          <ul>
            <li>Méthode agile</li>
            <li>Communication</li>
            <li>Entraide</li>
            <li>Bonne entente entre les salariés</li>
          </ul>
        </div>
      </div>

      <div class="slide">
        <h2>Le produit : Tuleap</h2>
        <div class="slide-content">
          <p class="center-text">ALM : Application Lifecycle Manager</p>
          <div class="soutenance-block">
            <p>
              Outil de gestion de projet agile avec un long panel de
              fonctionnalités
            </p>
            <img
              src="/images/soutenance-mmi3-juin-2026/agile_icon.svg"
              alt="Icône Agilité"
              style="border: none;"
            />
            <p>
              Ajuster aux besoins du projet et à la méthodologie des
              utilisateurs.
            </p>
          </div>
          <div class="soutenance-block">
            <p>
              Permet le suivi des activités, la gestion du code, la gestion des
              test, la documentation du projet et autres.
            </p>
            <img
              src="/images/soutenance-mmi3-juin-2026/gestion_icon.svg"
              alt="Icône Gestion"
              style="border: none;"
            />
          </div>
        </div>
      </div>

      <div class="slide title-slide">
        <h1>2. Présentation de ma mission</h1>
        <p>Ajout du mode sombre de Tuleap</p>
      </div>

      <div class="slide">
        <h2>Avant toute chose</h2>
        <div class="slide-content">
          <div class="soutenance-block reverse img-rows">
            <p class="center-text">
              Mise en place du plan d'action de ma <b>mission</b> et compréhension
              de la problématique.
            </p>
            <img
              src="/images/soutenance-mmi3-juin-2026/plan_action.png"
              alt="Plan d'action"
              style="height: 12rem;"
            />
          </div>
          <div class="soutenance-block img-rows">
            <p class="center-text">
              Formation pour la <b>prise en main</b> de Tuleap
            </p>
            <img
              src="/images/soutenance-mmi3-juin-2026/tuleap_formation.png"
              alt="Capture d'écran de la formation de Tuleap"
              style="height: 12rem;"
            />
          </div>
        </div>
      </div>

      <div class="slide">
        <h2>Problématiques</h2>
        <div class="soutenance-block reverse slide-content">
          <ul>
            <li>La lumière des écrans abîme les yeux des utilisateurs.</li>
            <li>
              Le changement d'onglet entre applications avec différents modes
              dérange.
            </li>
            <li>
              Le mode sombre est souvent utiliser par nos clients sur leurs
              autres outils, donc alignement stratégique requis.
            </li>
          </ul>
          <img
            src="/images/soutenance-mmi3-juin-2026/onglets.png"
            alt="Modes différents entre les onglets"
            style="height: 20rem;"
          />
        </div>
      </div>

      <div class="slide">
        <h2>Maquettage</h2>
        <div class="slide-content">
          <p class="center-text">Reprendre la maquette faite par le designer</p>
          <div class="soutenance-block img-rows">
            <p>Définir les couleurs pour le dark mode.</p>
            <img
              src="/images/soutenance-mmi3-juin-2026/maquette_light.png"
              alt="Maquette mode clair faite par le designer"
              class="zoomed"
              style="height: 10rem;"
            />
          </div>
          <div class="soutenance-block reverse img-rows">
            <p>Créer une variante de la maquette en sombre.</p>
            <img
              src="/images/soutenance-mmi3-juin-2026/maquette_dark.png"
              alt="Maquette mode sombre faite par moi"
              class="zoomed"
              style="height: 10rem;"
            />
          </div>
        </div>
      </div>

      <div class="slide">
        <h2>Ajout de la feature dans le code</h2>
        <div class="soutenance-block reverse slide-content">
          <ul>
            <li>Ajouter la <b>user preference</b>.</li>
            <li>Faire en sorte de détecter le mode choisi.</li>
            <li>Créer le bouton radio dans la page Apparence.</li>
            <li>Appliquer le <b>`data-attribute`</b> sur le body.</li>
            <li>Appliquer le style choisi (light-dark-system).</li>
          </ul>
          <img
            src="/images/soutenance-mmi3-juin-2026/user_pref.png"
            alt="User Preference"
            class="zoomed"
            style="height: 20rem;"
          />
        </div>
      </div>

      <div class="slide">
        <h2>Démarches réflectives : Problèmes</h2>
        <div class="soutenance-block slide-content">
          <ul>
            <li>
              Créer une variante du style pour avoir un mode sombre adéquate.
            </li>
            <li>
              Faire en sorte que l’utilisateur puisse choisir entre light, dark
              et system.
            </li>
            <li>
              Le fait que le style s’applique en fonction du mode choisi
              (surtout system).
            </li>
          </ul>
          <img
            src="/images/soutenance-mmi3-juin-2026/menu-light-dark.png"
            alt="Menu light dark system"
            style="height: 20rem;"
          />
        </div>
      </div>

      <div class="slide">
        <h2>Démarches réflectives : Solutions</h2>
        <div class="slide-content">
          <div class="soutenance-block reverse">
            <ul>
              <li>Créer des variantes de fichier <b>xxx-dark.scss</b>.</li>
              <li>Redéfinir dans un @media color-scheme.</li>
            </ul>
            <img
              src="/images/soutenance-mmi3-juin-2026/styles_dark.scss.png"
              alt="Capture d'écran de css"
              class="zoomed"
              style="height: 16rem;"
            />
          </div>
          <p class="center-content"><b>Solution apportée :</b></p>
          <p class="center-content">
            Créer un fichier color-scheme.scss et utiliser la fonction
            <b>light-dark()</b>.
          </p>
        </div>
      </div>

      <div class="slide">
        <h2>Organisation</h2>
        <div class="slide-content">
          <div class="soutenance-block img-rows">
            <ul>
              <li>Utilisation du <b>Kanban</b> avec Tuleap.</li>
              <li>Prioriser mes tâches.</li>
            </ul>
            <img
              src="/images/soutenance-mmi3-juin-2026/kanban.png"
              alt="Kanban Tuleap"
              class="zoomed"
              style="height: 10rem;"
            />
          </div>
          <div class="soutenance-block reverse img-rows">
            <ul>
              <li>Utilisation de Mattermost et WorkAdventure.</li>
              <li>Review de code avec Gerrit.</li>
            </ul>
            <img
              src="/images/soutenance-mmi3-juin-2026/workadventure.png"
              alt="Moyen de communication WorkAdventure"
              class="zoomed"
              style="height: 12rem;"
            />
          </div>
        </div>
      </div>

      <div class="slide">
        <h2>Ce que cela m’a apporté</h2>
        <div class="slide-content">
          <div class="soutenance-block reverse img-rows">
            <ul>
              <li>Organisation concrète avec mon équipe.</li>
              <li>Autonomie.</li>
            </ul>
            <img
              src="/images/soutenance-mmi3-juin-2026/agile_illustration.png"
              alt="Gestion de projet agile en groupe"
              style="height: 20rem; border: none;"
            />
          </div>
          <div class="soutenance-block img-rows">
            <ul>
              <li>Prise d’initiative.</li>
              <li>Défense de mes idées.</li>
            </ul>
            <img
              src="/images/soutenance-mmi3-juin-2026/reunion.svg"
              alt="Réunion"
              style="height: 14rem; border: none;"
            />
          </div>
        </div>
      </div>

      <div class="slide title-slide">
        <h1>3. Sélection de réalisations</h1>
        <p>et leurs liens entre la formation et l'alternance</p>
      </div>

      <div class="slide">
        <h2>Compétences utilisées en alternance</h2>
        <div class="soutenance-block slide-content">
          <ul>
            <li>Organisation de tâches avec Tuleap (gestion de projet).</li>
            <li>PHP (et Javascript).</li>
            <li>Découverte de <b>mustache</b> et du TypeScript.</li>
            <li>Gestion d’équipe avec Gerrit, WorkAdventure et Tuleap.</li>
          </ul>
          <img
            src="/images/soutenance-mmi3-juin-2026/mustache_example.png"
            alt="Capture d'écran de mustache"
            style="height: 16rem"
          />
        </div>
      </div>

      <div class="slide">
        <h2>Ajout du dark mode pour le Storybook</h2>
        <div class="soutenance-block reverse slide-content">
          <ul>
            <li>Découverte d'une nouvelle techno : <b>Typescript</b>.</li>
            <li>Veille et documentation.</li>
            <li>Tâche réalisée en autonomie.</li>
          </ul>
          <img
            src="/images/soutenance-mmi3-juin-2026/storybook.png"
            alt="Storybook"
            class="zoomed"
            style="height: 20rem"
          />
        </div>
      </div>

      <div class="slide">
        <h2>Compétences utilisées en formation</h2>
        <div class="soutenance-block slide-content">
          <ul>
            <li>Organisation de tâches avec Notion (gestion de projet).</li>
            <li>PHP et Javascript.</li>
            <li>Découverte de nouvelles technos.</li>
            <li>Gestion d’équipe avec Discord, Trello et Notion.</li>
          </ul>
          <img
            src="/images/soutenance-mmi3-juin-2026/notion_screen.png"
            alt="Capture d'écran de Notion"
            style="height: 20rem"
          />
        </div>
      </div>

      <div class="slide">
        <h2>Réalisation d'un jeu vidéo connecté</h2>
        <div class="soutenance-block reverse slide-content">
          <ul>
            <li>
              Gestion de projet en équipe grâce à <b>Notion</b> et autres canaux
            </li>
            <li>Organisation et répartition des tâches.</li>
            <li>
              Développement du jeu en <b>C# sur Unity</b> et initiation à <b
                >Blender</b
              > pour les modèles 3D.
            </li>
          </ul>
          <img
            src="/images/soutenance-mmi3-juin-2026/qui_vole_un_oeuf.png"
            alt="Capture d'écran du jeu `Qui vole un oeuf, vole un dragon`"
            class="zoomed"
            style="height: 20rem;"
          />
        </div>
      </div>

      <div class="slide title-slide">
        <h1>4. Bilan de la formation MMI</h1>
        <p>et de mon évolution de 2022 à 2026</p>
      </div>

      <div class="slide">
        <h2>Forces</h2>
        <div class="soutenance-block reverse slide-content">
          <ul>
            <li>Découverte de nouvelles technos.</li>
            <li>Organisation.</li>
            <li>Travail en équipe.</li>
            <li>Autonomie.</li>
          </ul>
          <img
              src="/images/soutenance-mmi3-juin-2026/kanban.png"
              alt="Organisation avec Kanban sur Tuleap"
              class="zoomed"
              style="height: 16rem;"
            />
        </div>
      </div>

      <div class="slide">
        <h2>Faiblesses</h2>
        <div class="soutenance-block slide-content">
          <ul>
            <li>Difficultés à apprendre différents langages simultanément.</li>
            <li>Temps pour me remettre "dans le bain".</li>
            <li>Redoublement.</li>
          </ul>
          <p><b>Solution apportée :</b></p>
          <ul>
            <li>Organisation.</li>
            <li>Ne pas me précipiter et en faire de mon côté.</li>
            <li>Projets perso et améliorer ma rigueur et mon autonomie.</li>
          </ul>
        </div>
      </div>

      <div class="slide title-slide">
        <h1>5. Avenir professionnel</h1>
        <p>Ce que je compte faire après MMI</p>
      </div>

      <div class="slide">
        <h2>Chronologie de mes objectifs</h2>
        <div class="slide-content">
          <div class="soutenance-block">
            <p>Démenager de Chambéry</p>
            <p><b>⬎</b></p>
          </div>
          <div class="soutenance-block reverse">
            <p>Continuer à travailler dans le dev web</p>
            <p><b>⬐</b></p>
          </div>
          <div class="soutenance-block">
            <p>M’organiser pour avancer davantage sur mes projets perso</p>
            <p><b>⬎</b></p>
          </div>
          <p class="center-content">
            Une fois mon portfolio approfondi, me tourner vers le dev de jeu
            vidéo.
          </p>
        </div>
      </div>

      <div class="slide">
        <h2>Conclusion</h2>
        <div class="soutenance-block slide-content">
          <ul>
            <li><b>MMI</b> m’a permis d’accroitre mon panel de compétences.</li>
            <li>
              Le travail en équipe ainsi que mon autonomie m’ont permis
              d’évoluer.
            </li>
            <li>
              L’alternance a permis de mettre en place mes nouvelles compétences
              et de m’insérer dans le <b>monde professionnel</b>.
            </li>
          </ul>
        </div>
      </div>

      <div class="slide title-slide">
        <h1>Merci de m'avoir écouté</h1>
      </div>
    </div>

    <button id="next-button">&gt;</button>
    <div id="slide-number"></div>
  </div>

  <script type="module" is:inline>
    let step = 0;

    const slides = document.querySelectorAll(".slide");
    const previousBtn = document.getElementById("previous-button");
    const nextBtn = document.getElementById("next-button");
    const pageNumber = document.getElementById("slide-number");

    function updateSlides() {
      slides.forEach((slide, index) => {
        slide.classList.toggle("active", index === step);
      });

      previousBtn.classList.toggle("transparent", step === 0);
      nextBtn.classList.toggle("transparent", step === slides.length - 1);

      pageNumber.textContent = `${step + 1} / ${slides.length}`;
    }

    previousBtn.addEventListener("click", () => {
      if (step > 0) {
        step--;
        updateSlides();
      }
    });

    nextBtn.addEventListener("click", () => {
      if (step < slides.length - 1) {
        step++;
        updateSlides();
      }
    });

    updateSlides();
  </script>
</BaseLayout>
